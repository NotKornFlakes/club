{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(gh pr merge *)",
      "Bash(gh pr -* merge *)",
      "Bash(gh pr -* merge)",
      "Bash(gh pr review *)",
      "Bash(gh pr -* review *)",
      "Bash(gh pr -* review)",
      "Bash(gh alias *)",

      "Bash(gh api *-X*)",
      "Bash(gh api *--method*)",
      "Bash(gh api *-f*)",
      "Bash(gh api *-F*)",
      "Bash(gh api *--input*)",

      "Bash(gh secret *)",
      "Bash(gh variable *)",
      "Bash(gh ruleset *)",
      "Bash(gh repo edit *)",
      "Bash(gh repo -* edit *)",
      "Bash(gh repo -* edit)",
      "Bash(gh repo delete *)",
      "Bash(gh repo archive *)",
      "Bash(gh repo rename *)",
      "Bash(gh repo deploy-key *)",
      "Bash(gh workflow enable *)",
      "Bash(gh workflow disable *)",
      "Bash(gh auth *)",

      "Bash(git push)",
      "Bash(git push origin)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push *:main*)",
      "Bash(git push *+main*)",
      "Bash(git push *heads/main*)",
      "Bash(git push *HEAD*)",
      "Bash(git push *--all*)",
      "Bash(git push *--mirror*)",
      "Bash(git -C *push*)",
      "Bash(git -c *push*)"
    ]
  }
}
