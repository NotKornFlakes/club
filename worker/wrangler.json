{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "club-booking",
  "main": "src/index.js",
  "compatibility_date": "2026-11-20",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "club-booking",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "LOGIN_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 100,
        "period": 60
      }
    }
  ],
  "secrets": {
    "required": [
      "PEPPER",
      "IP_HASH_KEY",
      "THROTTLE_SETTINGS",
      "TURNSTILE_SITE_KEY",
      "TURNSTILE_SECRET",
      "ADMIN_SETUP_TOKEN"
    ]
  },
  "triggers": {
    "crons": [
      "0 8 * * *"
    ]
  },
  "observability": {
    "enabled": true
  }
}
