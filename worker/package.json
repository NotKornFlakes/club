{
  "name": "club-booking-worker",
  "private": true,
  "type": "module",
  "description": "The club booking site: one Cloudflare Worker serving pages and /api.",
  "scripts": {
    "types": "wrangler types --include-runtime",
    "typecheck": "npm run types && tsc -p tsconfig.json && tsc -p test/tsconfig.json",
    "test": "vitest run",
    "build": "wrangler deploy --dry-run --outdir dist",
    "dev": "wrangler dev",
    "rules": "bash scripts/check-code-rules.sh"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.9.2",
    "typescript": "7.0.2",
    "vitest": "5.1.2",
    "wrangler": "4.168.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261123.1": true
  }
}
