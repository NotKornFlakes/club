{
  // Type-checks the plain JavaScript (// @ts-check + JSDoc). Nothing is compiled.
  "compilerOptions": {
    "target": "es2024",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2024"],
    "types": [],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    // The club's settings file (clubs/<club>/club.json) is imported as JSON.
    "resolveJsonModule": true
  },
  "include": ["src/**/*.js", "worker-configuration.d.ts"]
}
